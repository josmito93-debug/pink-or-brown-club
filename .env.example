# ==============================================================================
# PINK OR BROWN · CLUB — ENVIRONMENT VARIABLES TEMPLATE
# ==============================================================================
# Add these in Vercel: Project Settings -> Environment Variables
# And locally in your .env file
# ==============================================================================

# --- SUPABASE SETTINGS ---
# From Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOi...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# --- STRIPE PAYMENTS ---
# From Stripe Dashboard -> Developers -> API Keys
STRIPE_SECRET_KEY=sk_live_...
STRIPE_PUBLISHABLE_KEY=pk_live_...
# From Stripe Dashboard -> Developers -> Webhooks (Endpoint: https://your-site.vercel.app/api/stripe-webhook)
STRIPE_WEBHOOK_SECRET=whsec_...

# --- AUTOMATION & MODERATION (n8n / Instagram) ---
# A secure random secret for your n8n workflows
N8N_WEBHOOK_SECRET=your_super_secret_webhook_key_here
